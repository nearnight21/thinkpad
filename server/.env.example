# ThinkPad Server environment contract. This file contains no usable secrets.
# The Server does not load .env files automatically; inject values into the
# process environment or use the deployment platform's secret manager.

# Runtime: required for the current Server.
THINKPAD_DATABASE_URL=
THINKPAD_SITE_ORIGIN=http://127.0.0.1:3000
THINKPAD_COS_BUCKET=
THINKPAD_COS_REGION=
THINKPAD_COS_SECRET_ID=
THINKPAD_COS_SECRET_KEY=

# Runtime: optional defaults.
THINKPAD_HOST=127.0.0.1
THINKPAD_PORT=8790
THINKPAD_BASE_PATH=/thinkpad
THINKPAD_SESSION_DAYS=30
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# One-time source migration only. Never keep these in the normal Server env.
# Set exactly one source database URL.
SUPABASE_DB_URL=
THINKPAD_SOURCE_DATABASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Intentionally omitted: MEMORY_RECALL_* compatibility variables. They are
# legacy cross-product fallbacks and are not part of the ThinkPad contract.
