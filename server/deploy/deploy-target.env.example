# ThinkPad production deployment target. Copy to deploy-target.env.local and
# fill it on each authorized deployment workstation. Do not commit real values.

THINKPAD_DEPLOY_SSH_USER=
THINKPAD_DEPLOY_SSH_HOST=
THINKPAD_DEPLOY_SSH_PORT=22
THINKPAD_DEPLOY_SSH_IDENTITY=
THINKPAD_DEPLOY_WEB_ROOT=
THINKPAD_DEPLOY_WEB_ENTRY=
THINKPAD_DEPLOY_PUBLIC_URL=
THINKPAD_DEPLOY_LOCAL_HEALTH_URL=http://127.0.0.1:8790/health
THINKPAD_DEPLOY_API_CONTAINER=thinkpad-api-1
